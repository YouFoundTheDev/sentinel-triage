# Copy this file to .env and fill in your project. Never commit .env.
GOOGLE_CLOUD_PROJECT=your-project-id

# gemini-3.8-flash is available on the global, us, and eu endpoints, not us-central1.
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_ENTERPRISE=TRUE
GEMINI_MODEL=gemini-3.8-flash

BQ_DATASET=triage
BQ_TABLE=indicators
BQ_LOCATION=US

DATA_DIR=data/raw
CLEAN_DIR=data/clean
MAX_MALICIOUS_ROWS=5000
MAX_BENIGN_ROWS=5000
DNS_TIMEOUT_SECONDS=5
RDAP_TIMEOUT_SECONDS=5
RDAP_MAX_REDIRECTS=2
LOG_LEVEL=INFO
